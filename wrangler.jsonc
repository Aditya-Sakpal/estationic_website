{
  // The marketing site: static files from the Vite build, served by Cloudflare.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "estationic",
  // the company account (info@estationic.com), which also holds the estationic.com zone
  "account_id": "2a40e6fb48a574e423c58cc1132f9d92",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "routes": [
    { "pattern": "estationic.com", "custom_domain": true },
    { "pattern": "www.estationic.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
